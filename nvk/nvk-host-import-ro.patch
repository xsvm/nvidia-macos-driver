+ * NVOS02_FLAGS_ALLOC_USER_READ_ONLY, so a read-only range was refused (NV_STATUS 0x56) and the plugin copied the
+ * whole image with the CPU before every submission. A read-only range is now pinned read-only and mapped
+ * read-only for the GPU (RM sets DEVICE_READ_ONLY too), which is all the caller can ask of memory it cannot write. */
+static bool
+nvrm_host_range_writable(const void *ptr, uint64_t size_B)
+{
+#ifdef __APPLE__
+   mach_vm_address_t at = (mach_vm_address_t)(uintptr_t)ptr;
+   const mach_vm_address_t end = at + size_B;
+   while (at < end) {
+      mach_vm_address_t region = at;
+      mach_vm_size_t len = 0;
+      vm_region_basic_info_data_64_t info;
+      mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+      mach_port_t object = MACH_PORT_NULL;
+      if (mach_vm_region(mach_task_self(), &region, &len, VM_REGION_BASIC_INFO_64,
+                         (vm_region_info_t)&info, &count, &object) != KERN_SUCCESS)
