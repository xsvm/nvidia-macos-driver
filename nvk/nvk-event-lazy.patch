diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c
index 2db6f55..1e2d658 100644
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c
@@ -16,6 +16,166 @@
 #include "ctrl/ctrl2080/ctrl2080tmr.h"
 #include "class/cl0005.h" // NV01_EVENT (b73 device event)
 #include "class/cl2080_notification.h" // NV2080_NOTIFIERS_GRAPHICS
+#include "../../nvmtl_cfg.h"
+#include <time.h>
+
+/* Slow waits (past the 20 us spin) a device without its event polls through before it registers one, and how long
+ * the event then stays unused before it is dropped. RM posts every graphics completion to every registered event,
+ * so an idle process that kept its event made every other process's completions cost one more post; the polling
+ * those few waits pay instead is what every process did before b73. */
+#define NVRM_EVENT_LAZY_WAITS 16
+#define NVRM_EVENT_IDLE_NS    (2000ull * 1000 * 1000)
+
+static uint64_t
+nvrm_now_ns(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+
+/* 1 = register the event when the device is made and keep it, 0 = while in use, -1 = never. NVRM_EVENT_WAIT=0 turns
+ * every event sleep off, so no event is needed; NVRM_EVENT_WAIT=1 makes every process sleep like WindowServer. */
+static int
+nvrm_event_policy(void)
+{
+   static int policy = 2;
+   if (policy == 2) {
+      const char *e = nvmtl_cfg_getenv("NVRM_EVENT_WAIT");
+      const char *pn = getprogname();
+      if (e && e[0]) policy = e[0] == '0' ? -1 : 1;
+      else policy = pn && !strcmp(pn, "WindowServer") ? 1 : 0;
+   }
+   return policy;
+}
+
+/* b73: the device's ONE graphics non-stall event. Best effort: without it waits keep the polling backoff. */
+static bool
+nvrm_dev_event_alloc(struct nvkmd_nvrm_dev *dev)
+{
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   dev->osEvent = NVRM_OPEN(rm.nodeName);
+   if (dev->osEvent < 0)
+      return false;
+   struct NvRmApi rmOsEvent = rm;
+   rmOsEvent.fd = dev->osEvent;
+   NV0005_ALLOC_PARAMETERS eventParams = {
+      .hParentClient = pdev->hClient,
+      .hSrcResource = pdev->hSubdevice,
+      .hClass = NV01_EVENT_OS_EVENT,
+      .notifyIndex = NV2080_NOTIFIERS_GRAPHICS | NV01_EVENT_NONSTALL_INTR |
+                     NV01_EVENT_WITHOUT_EVENT_DATA | NV01_EVENT_SUBDEVICE_SPECIFIC |
+                     DRF_NUM(0005, _NOTIFY_INDEX, _SUBDEVICE, 0),
+      .data = (NvP64)(uintptr_t)dev->osEvent,
+   };
+   if (nvRmApiAllocOsEvent(&rmOsEvent, dev->osEvent) != NV_OK ||
+       nvRmApiAlloc(&rm, pdev->hSubdevice, &dev->hEvent, NV01_EVENT_OS_EVENT, &eventParams) != NV_OK) {
+      fprintf(stderr, "nvrm: device event NOT allocated - waits keep polling\n");
+      NVRM_CLOSE(dev->osEvent);
+      dev->osEvent = -1;
+      dev->hEvent = 0;
+      return false;
+   }
+   return true;
+}
+
+static void
+nvrm_dev_event_free(struct nvkmd_nvrm_dev *dev)
+{
+   if (dev->hEvent != 0) {
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(nvkmd_nvrm_pdev(dev->base.pdev), &rm);
+      nvRmApiFree(&rm, dev->hEvent);
+      dev->hEvent = 0;
+   }
+   if (dev->osEvent >= 0)
+      NVRM_CLOSE(dev->osEvent);
+   dev->osEvent = -1;
+}
+
+/* Runs while a device that does not keep its event has one: drops it after NVRM_EVENT_IDLE_NS without a wait, then
+ * ends. The next slow waits register it again and start a new one. */
+static void *
+nvrm_dev_event_idle(void *arg)
+{
+   struct nvkmd_nvrm_dev *dev = arg;
+   pthread_mutex_lock(&dev->eventMtx);
+   while (!dev->eventStopping) {
+      struct timespec until;
+      clock_gettime(CLOCK_REALTIME, &until);
+      until.tv_sec += 1;
+      pthread_cond_timedwait(&dev->eventCv, &dev->eventMtx, &until);
+      if (dev->eventStopping)
+         break;
+      if (nvrm_now_ns() - __atomic_load_n(&dev->eventLastUse, __ATOMIC_RELAXED) < NVRM_EVENT_IDLE_NS)
+         continue;
+      if (pthread_rwlock_trywrlock(&dev->eventLock) != 0)
+         continue;   // a wait is using it right now
+      nvrm_dev_event_free(dev);
+      __atomic_store_n(&dev->eventWaits, 0, __ATOMIC_RELAXED);
+      __atomic_store_n(&dev->eventState, 0, __ATOMIC_RELEASE);
+      pthread_rwlock_unlock(&dev->eventLock);
+      break;
+   }
+   pthread_mutex_unlock(&dev->eventMtx);
+   return NULL;
+}
+
+int
+nvkmd_nvrm_dev_event_get(struct nvkmd_nvrm_dev *dev, bool count_wait)
+{
+   if (__atomic_load_n(&dev->eventState, __ATOMIC_ACQUIRE) < 0)
+      return -1;
+   pthread_rwlock_rdlock(&dev->eventLock);
+   if (dev->eventState > 0) {
+      if (!dev->eventKeep)
+         __atomic_store_n(&dev->eventLastUse, nvrm_now_ns(), __ATOMIC_RELAXED);
+      return dev->osEvent;
+   }
+   pthread_rwlock_unlock(&dev->eventLock);
+   if (!count_wait || __atomic_add_fetch(&dev->eventWaits, 1, __ATOMIC_RELAXED) < NVRM_EVENT_LAZY_WAITS)
+      return -1;
+
+   pthread_rwlock_wrlock(&dev->eventLock);
+   if (dev->eventState == 0) {
+      const bool ok = nvrm_dev_event_alloc(dev);
+      __atomic_store_n(&dev->eventLastUse, nvrm_now_ns(), __ATOMIC_RELAXED);
+      if (ok) {
+         /* the previous idle thread has dropped the event and ended (or is ending): collect it first */
+         pthread_mutex_lock(&dev->eventMtx);
+         const bool joinOld = dev->eventIdleStarted;
+         dev->eventIdleStarted = false;
+         pthread_mutex_unlock(&dev->eventMtx);
+         if (joinOld)
+            pthread_join(dev->eventIdle, NULL);
+         pthread_mutex_lock(&dev->eventMtx);
+         dev->eventIdleStarted = !dev->eventStopping &&
+                                 pthread_create(&dev->eventIdle, NULL, nvrm_dev_event_idle, dev) == 0;
+         pthread_mutex_unlock(&dev->eventMtx);
+         if (!dev->eventIdleStarted) {
+            nvrm_dev_event_free(dev);   // nothing would drop it: stay with polling
+            __atomic_store_n(&dev->eventState, -1, __ATOMIC_RELEASE);
+         } else {
+            __atomic_store_n(&dev->eventState, 1, __ATOMIC_RELEASE);
+         }
+      } else {
+         __atomic_store_n(&dev->eventState, -1, __ATOMIC_RELEASE);
+      }
+      if (nvkmd_nvrm_diag_on())
+         fprintf(stderr, "nvrm: device event %s after %u slow waits\n", dev->eventState > 0 ? "registered" : "NOT registered",
+                 (unsigned)NVRM_EVENT_LAZY_WAITS);
+   }
+   pthread_rwlock_unlock(&dev->eventLock);
+   return nvkmd_nvrm_dev_event_get(dev, false);
+}
+
+void
+nvkmd_nvrm_dev_event_put(struct nvkmd_nvrm_dev *dev)
+{
+   pthread_rwlock_unlock(&dev->eventLock);
+}
 
